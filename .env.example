# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database
DATABASE_URL=

# LiveKit
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# Session recording (LiveKit Egress → S3-compatible storage). OPTIONAL —
# leave blank to disable; sessions still run, recordings just aren't captured.
# Works with AWS S3, Supabase Storage (S3 endpoint), Cloudflare R2, MinIO.
# Also register the egress webhook in the LiveKit dashboard:
#   https://<your-app>/api/livekit/egress-webhook
RECORDINGS_S3_BUCKET=
RECORDINGS_S3_ACCESS_KEY=
RECORDINGS_S3_SECRET=
RECORDINGS_S3_REGION=us-east-1
RECORDINGS_S3_ENDPOINT=
RECORDINGS_S3_FORCE_PATH_STYLE=false
RECORDINGS_PUBLIC_BASE_URL=
RECORDINGS_RETENTION_YEARS=7

# Transcription of finished recordings. OPTIONAL — set ONE.
# Deepgram is preferred (diarization → real per-speaker labels).
DEEPGRAM_API_KEY=
# OPENAI_API_KEY=   # Whisper fallback (segment timestamps, no diarization)

# Stripe Connect (for tutor payments)
# Get keys from https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_*, pk_test_*) for development
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51RtKNQRoJ2jHJxL77MCbPIcp0Yp90vnd91xQ2Et2VzOKZFrQ2alD1unyb3j05JyAficJnJxbFtv7Y4DVcypnYnpo00aq7tdiQc

# App URL (for Stripe Connect redirects; required in production)
# NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Email (transactional, via Resend — https://resend.com). Send-only.
# Verify learnpeers.com in Resend, then these From addresses just work — no
# mailbox needed. Personal inbox (edouard@) is separate (iCloud+ Custom Domain).
RESEND_API_KEY=
EMAIL_FROM_NOREPLY=LearnPeers <noreply@learnpeers.com>
EMAIL_FROM_HELLO=Edouard at LearnPeers <hello@learnpeers.com>
EMAIL_REPLY_TO=edouard@learnpeers.com
